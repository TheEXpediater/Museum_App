APP_NAME=Museum Guide System
APP_ENV=development

# compose.yaml publishes the MongoDB container on host port 27018 (mapped from its internal
# 27017) so it does not collide with a MongoDB instance already installed on the host.
MONGODB_URL=mongodb://localhost:27018
MONGODB_DATABASE=museum_guide

# Generate a real secret during setup; do not reuse this placeholder.
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_24_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
GUEST_SESSION_EXPIRE_HOURS=24

UPLOAD_DIRECTORY=uploads/images
MAX_IMAGE_SIZE_MB=10

# Created interactively by start_backend.py / setup.bat on first run.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_FULL_NAME=Museum Administrator

# 10.0.2.2 is the Android emulator's alias for the host laptop. The physical Android app does not
# use CORS (it is not a browser), so this only matters for browser-based API testing.
CORS_ORIGINS=http://localhost,http://localhost:8080,http://10.0.2.2

# AI / OpenCLIP / Qdrant
# Do not change QDRANT_COLLECTION, OPENCLIP_MODEL_NAME, or OPENCLIP_PRETRAINED on an existing
# installation - that would orphan the existing vector data.
AI_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=artifact_images
QDRANT_DISTANCE=cosine
OPENCLIP_MODEL_NAME=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k
OPENCLIP_DEVICE=auto
AI_MODEL_DOWNLOAD_ALLOWED=true

# Loads OpenCLIP once in the background at backend startup so Visitor recognition never depends
# on an admin opening Admin -> Recognize first.
AI_WARMUP_ON_STARTUP=true

AI_RECOGNITION_STRONG_THRESHOLD=0.45
AI_RECOGNITION_POSSIBLE_THRESHOLD=0.32
AI_RECOGNITION_MAX_RESULTS=5
AI_RECOGNITION_VECTOR_CANDIDATES=25

# 3D reconstruction (COLMAP -> GLB). This is a BEST-EFFORT PREVIEW feature, not professional
# photogrammetry: a draft model goes to admin Accept/Reject review before visitors ever see it,
# and the pipeline is tuned for an ~8GB RAM CPU-only laptop, not a workstation. It is an optional
# feature dependency - the rest of the museum system starts and works normally even when COLMAP
# is not installed. COLMAP_BIN may be a bare command resolved from PATH, or an absolute path.
MODEL_3D_ENABLED=true
COLMAP_BIN=colmap
COLMAP_USE_GPU=false
RECONSTRUCTION_DIRECTORY=uploads/reconstruction
MODEL_3D_DIRECTORY=uploads/models3d
# Purely a "more angles may help" recommendation shown to the admin - the real minimum to
# attempt a preview is 3 photos (see ABSOLUTE_MIN_IMAGES_FOR_SPARSE in reconstruction_service.py).
MODEL_3D_MIN_SOURCE_IMAGES=8
MODEL_3D_MIN_REGISTERED_RATIO=0.70
# Low-resource profile: working copies are downscaled to this many pixels on the longest side
# (aspect ratio preserved) and feature extraction/matching threads are capped, because feeding
# full-resolution phone photos with automatic threading crashed COLMAP outright on a real 8GB
# RAM / 4-core test machine. Raise MODEL_3D_CPU_THREADS to 2 only on a machine with clearly more
# headroom than that.
MODEL_3D_MAX_INPUT_DIMENSION=1280
MODEL_3D_CPU_THREADS=1
MODEL_3D_MAX_FEATURES=4096
MODEL_3D_SIMPLIFY_RATIO=0.25
MODEL_3D_MAX_GLB_MB=15

# Optional AI multi-view 3D fallback for artifacts where COLMAP photogrammetry cannot register
# enough photos (see app/services/model3d/ai_provider.py). Disabled by default: with
# AI_3D_ENABLED=false or no API key configured, the museum system, COLMAP, and all existing
# published models work exactly as before - only the admin's "Generate AI 3D Preview" option is
# hidden. AI-generated drafts still go through the same Admin Accept/Reject review as COLMAP
# drafts before Visitors can see them; nothing is ever auto-published.
AI_3D_ENABLED=false
# Currently supported: meshy (https://docs.meshy.ai) - Multi-Image to 3D API, up to 4 images.
AI_3D_PROVIDER=meshy
# Get a key from https://www.meshy.ai account settings. Never commit a real key.
AI_3D_API_KEY=

# Local, free, single-image "Quick AI 3D Preview" (TripoSR pretrained inference, no API key, no
# paid service). This is the DEFAULT Admin 3D generation mode - COLMAP photogrammetry remains
# available as the "Advanced" option. Runs as an isolated subprocess under TRIPOSR_ROOT with its
# own Python venv (see tools/triposr/), never inside this backend's own venv. If the isolated
# runtime is missing/undetected, the museum backend still starts normally - only "Quick AI 3D
# Preview" becomes unavailable; COLMAP and everything else keeps working.
LOCAL_AI_3D_ENABLED=true
LOCAL_AI_3D_PROVIDER=triposr
# Leave blank to use the conventional <TRIPOSR_ROOT>/.venv location.
TRIPOSR_ROOT=tools/triposr
TRIPOSR_PYTHON=
TRIPOSR_MODEL_PATH=stabilityai/TripoSR
# auto tries CUDA first and falls back to CPU automatically if generation runs out of VRAM.
TRIPOSR_DEVICE=auto
# Conservative defaults for a 4GB-VRAM GPU (e.g. GTX 1050 Ti). Raise on a machine with more VRAM.
TRIPOSR_CHUNK_SIZE=2048
TRIPOSR_MC_RESOLUTION=192
TRIPOSR_TEXTURE_RESOLUTION=1024
TRIPOSR_BAKE_TEXTURE=true
TRIPOSR_CPU_FALLBACK=true
TRIPOSR_TIMEOUT_SECONDS=1200
